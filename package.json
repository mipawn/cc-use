{
  "name": "cc-use",
  "version": "1.0.0",
  "description": "CLI tool for managing multiple Claude Code / Codex CLI configurations",
  "type": "module",
  "bin": {
    "cc-use": "./dist/cc-use"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:server": "bun run src/server/dev.ts",
    "dev:webui": "cd webui && bun run dev",
    "build:webui": "cd webui && bun run build",
    "embed:webui": "bun scripts/embed-webui.ts",
    "build": "bun run build:webui && bun run embed:webui && bun build ./src/index.ts --compile --outfile ./dist/cc-use",
    "build:cli": "bun build ./src/index.ts --compile --outfile ./dist/cc-use",
    "build:all": "bun run build:webui && bun run embed:webui && bun run build:darwin-arm64 && bun run build:darwin-x64 && bun run build:linux-x64 && bun run build:windows-x64",
    "build:darwin-arm64": "bun build ./src/index.ts --compile --target=bun-darwin-arm64 --outfile ./dist/cc-use-darwin-arm64",
    "build:darwin-x64": "bun build ./src/index.ts --compile --target=bun-darwin-x64 --outfile ./dist/cc-use-darwin-x64",
    "build:linux-x64": "bun build ./src/index.ts --compile --target=bun-linux-x64 --outfile ./dist/cc-use-linux-x64",
    "build:windows-x64": "bun build ./src/index.ts --compile --target=bun-windows-x64 --outfile ./dist/cc-use-windows-x64.exe"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "hono": "^4.11.7",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mipawn/cc-use.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cli",
    "config",
    "switch"
  ],
  "author": "mipawn",
  "license": "MIT"
}
