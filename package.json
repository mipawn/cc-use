{
  "name": "cc-use",
  "version": "3.3.0",
  "description": "Desktop configuration manager for Claude Code, Codex Desktop, and Claude Desktop",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "build": "tauri build",
    "build:dev": "tauri build --debug --config src-tauri/tauri.dev.conf.json",
    "prepare:daemon": "node scripts/prepare-daemon.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:web": "pnpm test",
    "test:web:watch": "pnpm test:watch",
    "test:web:coverage": "pnpm test:coverage",
    "test:rust": "cargo test --workspace",
    "test:all": "pnpm test:rust && pnpm test:web",
    "dev:daemon": "cargo build -p cc-use-daemon && ./target/debug/cc-use-daemon stop; ./target/debug/cc-use-daemon start && echo 'daemon restarted'"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.0.3",
    "@ant-design/icons": "^6.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "antd": "^6.2.3",
    "clsx": "^2.1.1",
    "i18next": "^25.8.0",
    "lodash-es": "^4.17.21",
    "nanoid": "^5.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.0",
    "remark-gfm": "^4.0.1",
    "simplebar-react": "^3.3.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tauri-apps/cli": "^2.11.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mipawn/cc-use.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "tauri",
    "desktop",
    "api-management"
  ],
  "author": "mipawn",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  }
}
